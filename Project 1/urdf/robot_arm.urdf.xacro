<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robotic_arm">

  <!-- Materials -->
  <material name="silver">
    <color rgba="0.7 0.7 0.7 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <!-- Cylinder Inertial Macro -->
  <xacro:macro name="cylinder_inertial" params="mass radius height *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${(1.0/12.0) * mass * (3.0*radius*radius + height*height)}" ixy="0.0" ixz="0.0"
               iyy="${(1.0/12.0) * mass * (3.0*radius*radius + height*height)}" iyz="0.0"
               izz="${0.5 * mass * radius * radius}"/>
    </inertial>
  </xacro:macro>

  <!-- World link fixed to Base -->
  <link name="world"/>

  <joint name="world_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
  </joint>

  <!-- Base Link -->
  <link name="base_link">
    <visual>
      <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.2" length="0.1"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.2" length="0.1"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="5.0" radius="0.2" height="0.1">
      <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
    </xacro:cylinder_inertial>
  </link>

  <!-- Joint 1 -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="100.0" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Shoulder Link -->
  <link name="shoulder_link">
    <visual>
      <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.1" length="0.2"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.1" length="0.2"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="4.0" radius="0.1" height="0.2">
      <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
    </xacro:cylinder_inertial>
  </link>

  <!-- Joint 2 -->
  <joint name="joint2" type="revolute">
    <parent link="shoulder_link"/>
    <child link="upper_arm_link"/>
    <origin xyz="0.0 0.0 0.2" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.04719" upper="2.09439" effort="150.0" velocity="2.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Upper Arm Link -->
  <link name="upper_arm_link">
    <visual>
      <origin xyz="0.0 0.0 0.2" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.08" length="0.4"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.2" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.08" length="0.4"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="3.0" radius="0.08" height="0.4">
      <origin xyz="0.0 0.0 0.2" rpy="0.0 0.0 0.0"/>
    </xacro:cylinder_inertial>
  </link>

  <!-- Joint 3 -->
  <joint name="joint3" type="revolute">
    <parent link="upper_arm_link"/>
    <child link="forearm_link"/>
    <origin xyz="0.0 0.0 0.4" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.61799" upper="2.61799" effort="100.0" velocity="2.5"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Forearm Link -->
  <link name="forearm_link">
    <visual>
      <origin xyz="0.0 0.0 0.15" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.06" length="0.3"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.15" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.06" length="0.3"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="2.0" radius="0.06" height="0.3">
      <origin xyz="0.0 0.0 0.15" rpy="0.0 0.0 0.0"/>
    </xacro:cylinder_inertial>
  </link>

  <!-- Joint 4 -->
  <joint name="joint4" type="revolute">
    <parent link="forearm_link"/>
    <child link="wrist_1_link"/>
    <origin xyz="0.0 0.0 0.3" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="50.0" velocity="3.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Wrist 1 Link -->
  <link name="wrist_1_link">
    <visual>
      <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.05" length="0.1"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.05" length="0.1"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="1.5" radius="0.05" height="0.1">
      <origin xyz="0.0 0.0 0.05" rpy="0.0 0.0 0.0"/>
    </xacro:cylinder_inertial>
  </link>

  <!-- Joint 5 -->
  <joint name="joint5" type="revolute">
    <parent link="wrist_1_link"/>
    <child link="wrist_2_link"/>
    <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.09439" upper="2.09439" effort="30.0" velocity="3.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- Wrist 2 Link -->
  <link name="wrist_2_link">
    <visual>
      <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.04" length="0.08"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.04" length="0.08"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="1.0" radius="0.04" height="0.08">
      <origin xyz="0.0 0.0 0.04" rpy="0.0 0.0 0.0"/>
    </xacro:cylinder_inertial>
  </link>

  <!-- Joint 6 -->
  <joint name="joint6" type="revolute">
    <parent link="wrist_2_link"/>
    <child link="end_effector"/>
    <origin xyz="0.0 0.0 0.08" rpy="0.0 0.0 0.0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-6.28318" upper="6.28318" effort="20.0" velocity="4.0"/>
    <dynamics damping="0.5" friction="0.1"/>
  </joint>

  <!-- End Effector Link -->
  <link name="end_effector">
    <visual>
      <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.04" length="0.02"/>
      </geometry>
    </collision>
    <xacro:cylinder_inertial mass="0.2" radius="0.04" height="0.02">
      <origin xyz="0.0 0.0 0.01" rpy="0.0 0.0 0.0"/>
    </xacro:cylinder_inertial>
  </link>

  <!-- Gazebo Colors -->
  <gazebo reference="base_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="shoulder_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="upper_arm_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="forearm_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="wrist_1_link">
    <material>Gazebo/Black</material>
  </gazebo>
  <gazebo reference="wrist_2_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="end_effector">
    <material>Gazebo/Red</material>
  </gazebo>

  <!-- ros2_control definition -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>
    <joint name="joint1">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint2">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint3">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint4">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint5">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint6">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- Gazebo ros2_control plugin -->
  <gazebo>
    <plugin name="gazebo_ros2_control" filename="libgazebo_ros2_control.so">
      <parameters>$(find robotic_arm_kinematics)/config/ros2_controllers.yaml</parameters>
    </plugin>
  </gazebo>

</robot>
