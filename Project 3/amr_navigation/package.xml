<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amr_navigation</name>
  <version>0.0.0</version>
  <description>Autonomous Mobile Robot (AMR) Navigation with EKF, SLAM, Custom A* Planner and Dynamic Deceleration Avoidance</description>
  <maintainer email="ikramabdiazizyusuf@gmail.com">ikram</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>robot_localization</depend>
  <depend>slam_toolbox</depend>
  <depend>navigation2</depend>
  <depend>xacro</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
